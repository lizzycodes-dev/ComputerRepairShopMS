<Page
    x:Class="ComputerRepairSystem_winui.Pages.BranchManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="24"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="Branch Management"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage company branches and locations."
                Opacity="0.7"
                FontSize="14"/>
        </StackPanel>

        <!-- TOOLBAR -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="BranchSearchBox"
                Grid.Column="0"
                PlaceholderText="Search branches..."
                TextChanged="BranchSearchBox_TextChanged"/>

            <Button
                x:Name="AddBranchButton"
                Grid.Column="1"
                Click="AddBranchButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="Add Branch" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="EditBranchButton"
                Grid.Column="2"
                IsEnabled="False"
                Click="EditBranchButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Edit"/>
                    <TextBlock Text="Edit" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="DeleteBranchButton"
                Grid.Column="3"
                IsEnabled="False"
                Click="DeleteBranchButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Delete"/>
                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="RefreshBranchButton"
                Grid.Column="4"
                Click="RefreshBranchButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Refresh"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- BRANCH LIST -->
        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->
                <Border
                    Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                    <Grid
                        Padding="16,12"
                        ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Branch Code"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Branch Name"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Address"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Phone"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="Email"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="Status"
                            FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- LIST -->
                <ListView
                    x:Name="BranchesListView"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="BranchesListView_SelectionChanged">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                <Grid
                                    Padding="16,12"
                                    ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding BranchCode}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding BranchName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Address}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Phone}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding Email}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{Binding Status}"
                                        VerticalAlignment="Center"/>

                                </Grid>
                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

        <!-- PAGINATION -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="12">

            <Button
                x:Name="PreviousPageButton"
                Click="PreviousPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Back"/>
                    <TextBlock Text="Previous" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="PageInfoText"
                VerticalAlignment="Center"/>

            <Button
                x:Name="NextPageButton"
                Click="NextPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Next" VerticalAlignment="Center"/>
                    <SymbolIcon Symbol="Forward"/>
                </StackPanel>
            </Button>

        </StackPanel>

    </Grid>

</Page>