<Page
    x:Class="ComputerRepairSystem.winui.Pages.TermsAndConditionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                MaxWidth="900"
                Spacing="18">

                <!-- Header -->
                <TextBlock
                    Text="Terms and Conditions"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Please read these terms and conditions carefully before using the Computer Repair Shop Management System. These terms apply to all registered companies and their authorized users."
                    FontSize="15"
                    TextWrapping="Wrap"
                    Opacity="0.7"/>

                <!-- Version Information -->
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12">

                        <TextBlock
                            x:Name="VersionTextBlock"
                            Text="Version 1.0"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="•"
                            Opacity="0.5"/>

                        <TextBlock
                            x:Name="LastUpdatedTextBlock"
                            Text="Last updated: October 2026"
                            FontSize="14"
                            Opacity="0.7"/>

                    </StackPanel>

                    <!-- Super Admin Button -->
                    <Button
                        x:Name="EditTermsButton"
                        Grid.Column="1"
                        Content="Edit Terms"
                        Click="EditTermsButton_Click"
                        Visibility="Collapsed"/>

                </Grid>

                <!-- Terms Content -->
                <Border
                    Padding="20"
                    CornerRadius="8">

                    <Grid>

                        <!-- Read-only content -->
                        <TextBlock
                            x:Name="TermsContentTextBlock"
                            TextWrapping="Wrap"
                            FontSize="15"
                            LineHeight="24"/>

                        <!-- Editable content -->
                        <TextBox
                            x:Name="TermsContentEditor"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            IsSpellCheckEnabled="False"
                            FontSize="15"
                            MinHeight="500"
                            Visibility="Collapsed"/>

                    </Grid>

                </Border>
                <!-- Edit Actions -->
                <StackPanel
                    x:Name="EditActionsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Visibility="Collapsed">

                    <Button
                        x:Name="CancelEditButton"
                        Content="Cancel"
                        Click="CancelEditButton_Click"/>

                    <Button
                        x:Name="SaveDraftButton"
                        Content="Save Draft"
                        Click="SaveDraftButton_Click"/>

                    <Button
                        x:Name="PublishButton"
                        Content="Publish"
                        Click="PublishButton_Click"/>

                </StackPanel>
            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>