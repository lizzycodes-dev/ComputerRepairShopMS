<Page
    x:Class="ComputerRepairSystem_winui.Pages.PayrollManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        Padding="32"
        RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ====================================== -->
        <!-- HEADER -->
        <!-- ====================================== -->

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Payroll Management"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage employee salary records, deductions, and payroll history."
                Opacity="0.7"/>

        </StackPanel>

        <!-- ====================================== -->
        <!-- PAYROLL SUMMARY -->
        <!-- ====================================== -->

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- TOTAL EMPLOYEES -->

            <Border
                Grid.Column="0"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1">

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Total Employees"
                        Opacity="0.7"/>

                    <TextBlock
                        x:Name="PayrollEmployeeCountText"
                        Text="0"
                        FontSize="24"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>


            <!-- TOTAL PAYROLL -->

            <Border
                Grid.Column="1"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1">

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Total Payroll"
                        Opacity="0.7"/>

                    <TextBlock
                        x:Name="PayrollBasicSalaryText"
                        Text="₱0.00"
                        FontSize="24"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>


            <!-- TOTAL DEDUCTIONS -->

            <Border
                Grid.Column="2"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1">

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Total Deductions"
                        Opacity="0.7"/>

                    <TextBlock
                        x:Name="PayrollDeductionsText"
                        Text="₱0.00"
                        FontSize="24"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>


            <!-- TOTAL NET SALARY -->

            <Border
                Grid.Column="3"
                Padding="18"
                CornerRadius="8"
                BorderThickness="1">

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Total Net Salary"
                        Opacity="0.7"/>

                    <TextBlock
                        x:Name="PayrollNetSalaryText"
                        Text="₱0.00"
                        FontSize="24"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>
        <!-- ====================================== -->
        <!-- TOOLBAR -->
        <!-- ====================================== -->

        <Grid
            Grid.Row="2"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- SEARCH -->

            <TextBox
                x:Name="PayrollSearchBox"
                Grid.Column="0"
                Header="Search"
                PlaceholderText="Search employee..."
                TextChanged="PayrollSearchBox_TextChanged"/>


            <!-- ADD PAYROLL -->

            <Button
                x:Name="AddPayrollButton"
                Grid.Column="1"
                Content="Add Payroll"
                VerticalAlignment="Bottom"
                Click="AddPayrollButton_Click"/>

        </Grid>


        <!-- ====================================== -->
        <!-- PAYROLL LIST -->
        <!-- ====================================== -->

        <Border
            Grid.Row="3"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">

            <ListView
                x:Name="PayrollList"
                SelectionMode="Single">

                <!-- ================================== -->
                <!-- HEADER -->
                <!-- ================================== -->

                <ListView.Header>

                    <Grid Padding="8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.5*"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Grid.Column="0"
                            Text="ID"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Employee"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Period Start"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Period End"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="Basic Salary"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="Deductions"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="6"
                            Text="Net Salary"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="7"
                            Text="Action"
                            FontWeight="SemiBold"/>

                    </Grid>

                </ListView.Header>


                <!-- ================================== -->
                <!-- ROW -->
                <!-- ================================== -->

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Grid Padding="8">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.5*"/>

                            </Grid.ColumnDefinitions>


                            <!-- PAYROLL ID -->

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding PayrollId}"
                                VerticalAlignment="Center"/>


                            <!-- EMPLOYEE -->

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding EmployeeName}"
                                VerticalAlignment="Center"/>


                            <!-- PERIOD START -->

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding PayPeriodStartText}"
                                VerticalAlignment="Center"/>


                            <!-- PERIOD END -->

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding PayPeriodEndText}"
                                VerticalAlignment="Center"/>


                            <!-- BASIC SALARY -->

                            <TextBlock
                                Grid.Column="4"
                                Text="{Binding BasicSalaryText}"
                                VerticalAlignment="Center"/>


                            <!-- DEDUCTIONS -->

                            <TextBlock
                                Grid.Column="5"
                                Text="{Binding DeductionsText}"
                                VerticalAlignment="Center"/>


                            <!-- NET SALARY -->

                            <TextBlock
                                Grid.Column="6"
                                Text="{Binding NetSalaryText}"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"/>


                            <!-- ACTIONS -->

                            <StackPanel
                                Grid.Column="7"
                                Orientation="Horizontal"
                                Spacing="8">

                                <Button
                                    Content="Edit"
                                    Tag="{Binding}"
                                    Click="EditPayrollButton_Click"/>

                                <Button
                                    Content="Delete"
                                    Tag="{Binding}"
                                    Click="DeletePayrollButton_Click"/>

                            </StackPanel>

                        </Grid>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>

    </Grid>

</Page>