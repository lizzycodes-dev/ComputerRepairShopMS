<Page
    x:Class="ComputerRepairSystem.winui.Pages.SupplierManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock
                    Text="Supplier Management"
                    FontSize="28"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Manage suppliers that provide parts, supplies, and other inventory items."
                    Opacity="0.7"
                    Margin="0,4,0,0"/>
            </StackPanel>

            <Button
                Grid.Column="1"
                Padding="16,8"
                Click="AddSupplierButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <SymbolIcon Symbol="Add"/>

                    <TextBlock
                        Text="Add Supplier"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Button>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Search supplier..."
                TextChanged="SearchBox_TextChanged"
                Margin="0,0,12,0"/>

            <Button
                Grid.Column="1"
                Padding="16,8"
                Click="RefreshButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <SymbolIcon Symbol="Refresh"/>

                    <TextBlock
                        Text="Refresh"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Button>
        </Grid>

        <!-- Supplier List -->
        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border
                    Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                    <Grid Padding="16,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Code" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Supplier" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Contact Person" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Phone" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Email" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Address" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="7" Text="Action" FontWeight="SemiBold" MinWidth="160"/>

                    </Grid>

                </Border>

                <!-- Supplier Rows -->
                <ListView
                    Grid.Row="1"
                    x:Name="SupplierListView"
                    SelectionMode="None">

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                <Grid Padding="16,12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding SupplierId}"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding SupplierCode}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SupplierName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding ContactPerson}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{Binding Phone}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{Binding Email}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{Binding Address}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <StackPanel
                                        Grid.Column="7"
                                        Orientation="Horizontal"
                                        Spacing="6">

                                        <Button
                                            Tag="{Binding}"
                                            Click="EditSupplierButton_Click">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">

                                                <SymbolIcon Symbol="Edit"/>

                                                <TextBlock
                                                    Text="Edit"
                                                    VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Button>

                                        <Button
                                            Tag="{Binding}"
                                            Click="DeleteSupplierButton_Click">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">

                                                <SymbolIcon Symbol="Delete"/>

                                                <TextBlock
                                                    Text="Delete"
                                                    VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Button>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

        <!-- Pagination -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="12"
            Margin="0,16,0,0">

            <Button
                x:Name="PreviousPageButton"
                Click="PreviousPageButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <SymbolIcon Symbol="Back"/>

                    <TextBlock
                        Text="Previous"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <TextBlock
                x:Name="PageInfoText"
                VerticalAlignment="Center"/>

            <Button
                x:Name="NextPageButton"
                Click="NextPageButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Next"
                        VerticalAlignment="Center"/>

                    <SymbolIcon Symbol="Forward"/>

                </StackPanel>

            </Button>

        </StackPanel>

    </Grid>

</Page>