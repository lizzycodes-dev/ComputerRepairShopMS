<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.RepairManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="RowDividerBrush" Color="#22808080"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0F808080"/>
    </Page.Resources>

    <Grid
        Padding="32"
        RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Repair Management"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Review and manage customer service requests and repairs."
                Opacity="0.7"/>

        </StackPanel>

        <!-- TABS -->

        <TabView
            Grid.Row="1"
            x:Name="RepairTabView"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False">

            <!-- ================================= -->
            <!-- SERVICE REQUESTS -->
            <!-- ================================= -->

            <TabViewItem
                Header="Service Requests"
                IsClosable="False">

                <Grid
                    Padding="0,16,0,0"
                    RowSpacing="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource RowDividerBrush}"
                        CornerRadius="8">

                        <ListView
                            x:Name="ServiceRequestList"
                            SelectionMode="None">

                            <ListView.Header>
                                <Border
                                    BorderBrush="{StaticResource RowDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Customer" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Device" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="Description" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="Priority" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="5" Text="Action" FontWeight="SemiBold" MinWidth="100"/>
                                    </Grid>
                                </Border>
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BorderBrush="{StaticResource RowDividerBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Device.Customer.FirstName}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Device.Customer.MiddleName, TargetNullValue=''}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Device.Customer.LastName}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Text="{Binding Device.Model}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                       Text="{Binding Priority}"/>

                                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                       Text="{Binding Status}"/>

                                            <Button Grid.Column="5"
                                                    MinWidth="100"
                                                    Click="DiagnoseButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <SymbolIcon Symbol="Repair"/>
                                                    <TextBlock Text="Diagnose" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- PAGINATION -->

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">

                        <Button x:Name="PreviousServiceRequestPageButton"
                                Click="PreviousServiceRequestPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Back"/>
                                <TextBlock Text="Previous" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="ServiceRequestPageInfoText"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="NextServiceRequestPageButton"
                                Click="NextServiceRequestPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Next" VerticalAlignment="Center"/>
                                <SymbolIcon Symbol="Forward"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabViewItem>


            <!-- ================================= -->
            <!-- ACTIVE REPAIRS -->
            <!-- ================================= -->

            <TabViewItem
                Header="Repairs"
                IsClosable="False">

                <Grid
                    Padding="0,16,0,0"
                    RowSpacing="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource RowDividerBrush}"
                        CornerRadius="8">

                        <ListView
                            x:Name="RepairList"
                            SelectionMode="None">

                            <ListView.Header>
                                <Border
                                    BorderBrush="{StaticResource RowDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Customer" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Device" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="Technician" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="Diagnosis" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="5" Text="Action" FontWeight="SemiBold" MinWidth="100"/>
                                    </Grid>
                                </Border>
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BorderBrush="{StaticResource RowDividerBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ServiceRequest.Device.Customer.FirstName}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding ServiceRequest.Device.Customer.LastName}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Text="{Binding ServiceRequest.Device.Model}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Technician.FirstName}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Technician.LastName}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                       Text="{Binding Diagnosis}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                       Text="{Binding Status}"/>

                                            <Button Grid.Column="5"
                                                    MinWidth="100"
                                                    Click="OpenRepairButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <SymbolIcon Symbol="OpenFile"/>
                                                    <TextBlock Text="Open" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- PAGINATION -->

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">

                        <Button x:Name="PreviousRepairPageButton"
                                Click="PreviousRepairPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Back"/>
                                <TextBlock Text="Previous" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="RepairPageInfoText"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="NextRepairPageButton"
                                Click="NextRepairPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Next" VerticalAlignment="Center"/>
                                <SymbolIcon Symbol="Forward"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabViewItem>


            <!-- ================================= -->
            <!-- REPAIR HISTORY -->
            <!-- ================================= -->

            <TabViewItem
                Header="Repair History"
                IsClosable="False">

                <Grid
                    Padding="0,16,0,0"
                    RowSpacing="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{StaticResource RowDividerBrush}"
                        CornerRadius="8">

                        <ListView
                            x:Name="RepairHistoryList"
                            SelectionMode="None">

                            <ListView.Header>
                                <Border
                                    BorderBrush="{StaticResource RowDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Customer" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Device" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="Technician" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="Started" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="5" Text="Completed" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="6" Text="Action" FontWeight="SemiBold" MinWidth="100"/>
                                    </Grid>
                                </Border>
                            </ListView.Header>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BorderBrush="{StaticResource RowDividerBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ServiceRequest.Device.Customer.FirstName}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding ServiceRequest.Device.Customer.LastName}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Text="{Binding ServiceRequest.Device.Model}"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Technician.FirstName}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Technician.LastName}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                       Text="{Binding Status}"/>

                                            <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                       Text="{Binding StartDate}"/>

                                            <TextBlock Grid.Column="5" VerticalAlignment="Center"
                                                       Text="{Binding EndDate}"/>

                                            <Button Grid.Column="6"
                                                    MinWidth="100"
                                                    Click="OpenRepairButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <SymbolIcon Symbol="OpenFile"/>
                                                    <TextBlock Text="Open" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- PAGINATION -->

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">

                        <Button x:Name="PreviousHistoryPageButton"
                                Click="PreviousHistoryPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Back"/>
                                <TextBlock Text="Previous" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="HistoryPageInfoText"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="NextHistoryPageButton"
                                Click="NextHistoryPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Next" VerticalAlignment="Center"/>
                                <SymbolIcon Symbol="Forward"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabViewItem>

        </TabView>

    </Grid>

</Page>