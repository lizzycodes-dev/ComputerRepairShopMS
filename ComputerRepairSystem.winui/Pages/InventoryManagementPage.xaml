<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.InventoryManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Subtle divider line for table rows -->
        <SolidColorBrush
            x:Key="RowDividerBrush"
            Color="#22808080"/>
    </Page.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid
            Padding="32"
            RowSpacing="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <TextBlock
                    Text="Inventory Management"
                    FontSize="32"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Manage inventory items and available stock."
                    Opacity="0.7"/>

            </StackPanel>


            <!-- SEARCH + BUTTONS -->

            <Grid
                Grid.Row="1"
                ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="Search inventory items..."
                    TextChanged="SearchBox_TextChanged"/>


                <!-- NEW ITEM -->

                <Button
                    x:Name="NewItemButton"
                    Grid.Column="1"
                    Click="NewItemButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Add"/>
                        <TextBlock Text="New Item" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>


                <!-- ADD STOCK -->

                <Button
                    x:Name="AddStockButton"
                    Grid.Column="2"
                    Click="AddStockButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Add"/>
                        <TextBlock Text="Add Stock" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>


            <!-- INVENTORY TABLE -->

            <Border
                Grid.Row="2"
                BorderThickness="1"
                CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <ListView
                        x:Name="InventoryList"
                        Grid.Row="0"
                        SelectionMode="None">

                        <ListView.Header>

                            <Border
                                BorderBrush="{StaticResource RowDividerBrush}"
                                BorderThickness="0,0,0,1">

                                <Grid
                                    Padding="16,12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                        Grid.Column="0"
                                        Text="Item"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="Category"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="Brand / Model"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="Unit"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="Available"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="Action"
                                        FontWeight="SemiBold"/>

                                </Grid>

                            </Border>

                        </ListView.Header>


                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    BorderBrush="{StaticResource RowDividerBrush}"
                                    BorderThickness="0,0,0,1">

                                    <Grid
                                        Padding="16,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- ITEM -->

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding ItemName}"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"/>


                                        <!-- CATEGORY -->

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Category}"
                                            VerticalAlignment="Center"/>


                                        <!-- BRAND / MODEL -->

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center">

                                            <Run Text="{Binding Brand}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Model}"/>

                                        </TextBlock>


                                        <!-- UNIT -->

                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding Unit}"
                                            VerticalAlignment="Center"/>


                                        <!-- AVAILABLE -->

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding AvailableQuantity}"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"/>


                                        <!-- ACTION -->

                                        <Button
                                            Grid.Column="5"
                                            Tag="{Binding}"
                                            Click="EditItemButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <SymbolIcon Symbol="Edit"/>
                                                <TextBlock Text="Edit" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>


                    <!-- PAGINATION -->

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Padding="0,12,0,16">

                        <Button
                            x:Name="PreviousPageButton"
                            Click="PreviousPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <SymbolIcon Symbol="Back"/>
                                <TextBlock Text="Previous" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock
                            x:Name="PageInfoText"
                            VerticalAlignment="Center"/>

                        <Button
                            x:Name="NextPageButton"
                            Click="NextPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Next" VerticalAlignment="Center"/>
                                <SymbolIcon Symbol="Forward"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>