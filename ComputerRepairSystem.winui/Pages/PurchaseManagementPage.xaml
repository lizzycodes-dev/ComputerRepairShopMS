<Page
    x:Class="ComputerRepairSystem_winui.Pages.PurchaseManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Padding="24"
            Spacing="20">

            <!-- ========================================== -->
            <!-- HEADER                                     -->
            <!-- ========================================== -->

            <StackPanel
                Spacing="4">

                <TextBlock
                    Text="Purchase Management"
                    FontSize="30"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="Record purchases from suppliers and update inventory stock."
                    Opacity="0.7"/>

            </StackPanel>


            <!-- ========================================== -->
            <!-- PURCHASE TABS                              -->
            <!-- ========================================== -->

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TabView
                    x:Name="PurchaseTabView"
                    Grid.Column="0"
                    IsAddTabButtonVisible="False"
                    HorizontalAlignment="Stretch">


                    <!-- ====================================== -->
                    <!-- PURCHASE TRANSACTIONS TAB              -->
                    <!-- ====================================== -->

                    <TabViewItem
                        Header="Purchase Transactions"
                        IsClosable="False">

                        <Border
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,8,0,0">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- TAB TITLE -->

                                <TextBlock
                                    Grid.Row="0"
                                    Text="Purchase Transactions"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Margin="16,16,16,12"/>


                                <!-- PURCHASE LIST -->

                                <ListView
                                    Grid.Row="1"
                                    x:Name="PurchaseListView"
                                    SelectionMode="None">

                                    <ListView.Header>

                                        <Border
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                            <Grid Padding="16,12">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>


                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="Purchase #"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="Supplier"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="Purchase Date"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="Status"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Grid.Column="4"
                                                    Text="Total"
                                                    FontWeight="SemiBold"/>

                                                <TextBlock
                                                    Grid.Column="5"
                                                    Text="Action"
                                                    FontWeight="SemiBold"
                                                    MinWidth="180"/>

                                            </Grid>

                                        </Border>

                                    </ListView.Header>


                                    <ListView.ItemTemplate>

                                        <DataTemplate>

                                            <Border
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                                <Grid Padding="16,12">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>


                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding PurchaseOrderNumber}"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding SupplierName}"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding PurchaseDateText}"
                                                        VerticalAlignment="Center"/>

                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Text="{Binding Status}"
                                                        VerticalAlignment="Center"/>

                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Text="{Binding TotalAmountText}"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"/>


                                                    <StackPanel
                                                        Grid.Column="5"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">

                                                        <Button
                                                            Tag="{Binding}"
                                                            Click="ViewPurchaseButton_Click">

                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center">

                                                                <SymbolIcon Symbol="View"/>

                                                                <TextBlock
                                                                    Text="View"
                                                                    VerticalAlignment="Center"/>

                                                            </StackPanel>

                                                        </Button>

                                                        <Button
                                                            Tag="{Binding}"
                                                            Click="EditPurchaseButton_Click">

                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center">

                                                                <SymbolIcon Symbol="Edit"/>

                                                                <TextBlock
                                                                    Text="Edit"
                                                                    VerticalAlignment="Center"/>

                                                            </StackPanel>

                                                        </Button>

                                                        <Button
                                                            Tag="{Binding}"
                                                            Click="DeletePurchaseButton_Click">

                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center">

                                                                <SymbolIcon Symbol="Delete"/>

                                                                <TextBlock
                                                                    Text="Delete"
                                                                    VerticalAlignment="Center"/>

                                                            </StackPanel>

                                                        </Button>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>


                                <!-- EMPTY STATE -->

                                <TextBlock
                                    Grid.Row="2"
                                    x:Name="EmptyStateText"
                                    Text="No purchase transactions have been recorded yet."
                                    HorizontalAlignment="Center"
                                    Margin="16,20,16,20"
                                    Opacity="0.6"
                                    Visibility="Collapsed"/>


                                <!-- PAGINATION -->

                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="12"
                                    Margin="16,8,16,16">

                                    <Button
                                        x:Name="PreviousPageButton"
                                        Click="PreviousPageButton_Click">

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                            <SymbolIcon Symbol="Back"/>

                                            <TextBlock
                                                Text="Previous"
                                                VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>

                                    <TextBlock
                                        x:Name="PageInfoText"
                                        VerticalAlignment="Center"/>

                                    <Button
                                        x:Name="NextPageButton"
                                        Click="NextPageButton_Click">

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="Next"
                                                VerticalAlignment="Center"/>

                                            <SymbolIcon Symbol="Forward"/>

                                        </StackPanel>

                                    </Button>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </TabViewItem>


                    <!-- ====================================== -->
                    <!-- PURCHASE DETAILS TAB                   -->
                    <!-- ====================================== -->

                    <TabViewItem
                        x:Name="PurchaseDetailsTab"
                        Header="Purchase Details"
                        IsClosable="False">

                        <ScrollViewer
                            Margin="0,8,0,0"
                            VerticalScrollBarVisibility="Auto">

                            <StackPanel
                                Spacing="16">

                                <!-- ================================== -->
                                <!-- PURCHASE INFORMATION CARD          -->
                                <!-- ================================== -->

                                <Border
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">

                                    <StackPanel Spacing="16">

                                        <TextBlock
                                            Text="Purchase Information"
                                            FontSize="20"
                                            FontWeight="SemiBold"/>


                                        <Grid ColumnSpacing="24">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- PURCHASE NUMBER -->

                                            <StackPanel
                                                Grid.Column="0"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Purchase Number"
                                                    Opacity="0.7"
                                                    FontSize="12"/>

                                                <TextBlock
                                                    x:Name="PurchaseNumberText"
                                                    Text="—"
                                                    FontWeight="SemiBold"
                                                    FontSize="15"
                                                    TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>


                                            <!-- SUPPLIER -->

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Supplier"
                                                    Opacity="0.7"
                                                    FontSize="12"/>

                                                <TextBlock
                                                    x:Name="SupplierText"
                                                    Text="—"
                                                    FontWeight="SemiBold"
                                                    FontSize="15"
                                                    TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>


                                            <!-- PURCHASE DATE -->

                                            <StackPanel
                                                Grid.Column="2"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Purchase Date"
                                                    Opacity="0.7"
                                                    FontSize="12"/>

                                                <TextBlock
                                                    x:Name="PurchaseDateText"
                                                    Text="—"
                                                    FontWeight="SemiBold"
                                                    FontSize="15"/>

                                            </StackPanel>


                                            <!-- STATUS -->

                                            <StackPanel
                                                Grid.Column="3"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Status"
                                                    Opacity="0.7"
                                                    FontSize="12"/>

                                                <TextBlock
                                                    x:Name="PurchaseStatusText"
                                                    Text="—"
                                                    FontWeight="SemiBold"
                                                    FontSize="15"/>

                                            </StackPanel>

                                        </Grid>

                                    </StackPanel>

                                </Border>


                                <!-- ================================== -->
                                <!-- PURCHASED ITEMS CARD               -->
                                <!-- ================================== -->

                                <Border
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- CARD TITLE -->

                                        <TextBlock
                                            Grid.Row="0"
                                            Text="Purchased Items"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Margin="20,16,20,12"/>


                                        <!-- ITEMS LIST -->

                                        <ListView
                                            Grid.Row="1"
                                            x:Name="PurchaseItemsListView"
                                            SelectionMode="None">

                                            <ListView.Header>

                                                <Border
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                                    <Grid Padding="16,12">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.5*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                        </Grid.ColumnDefinitions>


                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="Item"
                                                            FontWeight="SemiBold"/>

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="Quantity"
                                                            FontWeight="SemiBold"/>

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Text="Unit Cost"
                                                            FontWeight="SemiBold"/>

                                                        <TextBlock
                                                            Grid.Column="3"
                                                            Text="Subtotal"
                                                            FontWeight="SemiBold"/>

                                                    </Grid>

                                                </Border>

                                            </ListView.Header>


                                            <ListView.ItemTemplate>

                                                <DataTemplate>

                                                    <Border
                                                        BorderThickness="0,0,0,1"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                                        <Grid Padding="16,12">

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2.5*"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                            </Grid.ColumnDefinitions>


                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Text="{Binding ItemName}"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding QuantityText}"
                                                                VerticalAlignment="Center"/>

                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Text="{Binding UnitCostText}"
                                                                VerticalAlignment="Center"/>

                                                            <TextBlock
                                                                Grid.Column="3"
                                                                Text="{Binding SubtotalText}"
                                                                VerticalAlignment="Center"
                                                                FontWeight="SemiBold"/>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ListView.ItemTemplate>

                                        </ListView>


                                        <!-- TOTAL CALLOUT -->

                                        <Border
                                            Grid.Row="2"
                                            Margin="16"
                                            Padding="20,14"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                VerticalAlignment="Center">

                                                <TextBlock
                                                    Text="Total Purchase:"
                                                    FontWeight="SemiBold"
                                                    FontSize="15"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    x:Name="SelectedPurchaseTotalText"
                                                    Text="₱0.00"
                                                    FontWeight="Bold"
                                                    FontSize="20"
                                                    VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </TabViewItem>

                </TabView>


                <!-- ADD PURCHASE BUTTON -->

                <Button
                    x:Name="AddNewPurchaseButton"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Padding="16,10"
                    Click="AddNewPurchaseButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <SymbolIcon Symbol="Add"
                                    VerticalAlignment="Center"/>

                        <TextBlock
                            Text="Add New Purchase"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                </Button>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Page>