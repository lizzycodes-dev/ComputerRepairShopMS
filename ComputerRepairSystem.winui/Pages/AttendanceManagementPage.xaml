<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.AttendanceManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid
        Padding="32"
        RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ====================================== -->
        <!-- HEADER                                 -->
        <!-- ====================================== -->

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Attendance Management"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage employee attendance and time records."
                Opacity="0.7"/>

        </StackPanel>


        <!-- ====================================== -->
        <!-- TOOLBAR                                -->
        <!-- ====================================== -->

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search employee..."
                TextChanged="SearchBox_TextChanged"
                MinWidth="250"/>


            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    x:Name="AddAttendanceButton"
                    Click="AddAttendanceButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                        <SymbolIcon Symbol="Add"/>

                        <TextBlock
                            Text="Add Attendance"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button
                    x:Name="EditAttendanceButton"
                    IsEnabled="False"
                    Click="EditAttendanceButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                        <SymbolIcon Symbol="Edit"/>

                        <TextBlock
                            Text="Edit"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button
                    x:Name="DeleteAttendanceButton"
                    IsEnabled="False"
                    Click="DeleteAttendanceButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                        <SymbolIcon Symbol="Delete"/>

                        <TextBlock
                            Text="Delete"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                        <SymbolIcon Symbol="Refresh"/>

                        <TextBlock
                            Text="Refresh"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>


        <!-- ====================================== -->
        <!-- ATTENDANCE TABLE                       -->
        <!-- ====================================== -->

        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="8">

            <ListView
                x:Name="AttendanceListView"
                SelectionMode="Single"
                SelectionChanged="AttendanceListView_SelectionChanged">

                <ListView.Header>

                    <Border
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                        <Grid Padding="16,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Grid.Column="0"
                                Text="Employee"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Date"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Time In"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="Time Out"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="4"
                                Text="Status"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="5"
                                Text="Remarks"
                                FontWeight="SemiBold"/>

                        </Grid>

                    </Border>

                </ListView.Header>


                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                            <Grid Padding="16,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding EmployeeName}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding AttendanceDateText}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding TimeInText}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding TimeOutText}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding StatusText}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding RemarksText}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>


        <!-- ====================================== -->
        <!-- PAGINATION                             -->
        <!-- ====================================== -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="12">

            <Button
                x:Name="PreviousPageButton"
                Click="PreviousPageButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <SymbolIcon Symbol="Back"/>

                    <TextBlock
                        Text="Previous"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <TextBlock
                x:Name="PageInfoText"
                VerticalAlignment="Center"/>

            <Button
                x:Name="NextPageButton"
                Click="NextPageButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Next"
                        VerticalAlignment="Center"/>

                    <SymbolIcon Symbol="Forward"/>

                </StackPanel>

            </Button>

        </StackPanel>

    </Grid>

</Page>