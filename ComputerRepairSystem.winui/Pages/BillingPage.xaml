<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush
            x:Key="RowDividerBrush"
            Color="#22808080"/>
    </Page.Resources>

    <Grid Padding="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Billing"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Process payments for completed repairs."
                Opacity="0.7"/>

        </StackPanel>


        <!-- FILTER BAR -->

        <Grid
            Grid.Row="1"
            Margin="0,20,0,12"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- SEARCH -->

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search customer, device, or repair..."
                TextChanged="SearchBox_TextChanged"
                VerticalAlignment="Bottom"/>


            <!-- START DATE -->

            <CalendarDatePicker
                x:Name="StartDatePicker"
                Grid.Column="1"
                Header="From"
                PlaceholderText="Start date"
                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                DateChanged="DateFilter_DateChanged"
                Width="180"/>


            <!-- END DATE -->

            <CalendarDatePicker
                x:Name="EndDatePicker"
                Grid.Column="2"
                Header="To"
                PlaceholderText="End date"
                DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                DateChanged="DateFilter_DateChanged"
                Width="180"/>


            <!-- CLEAR BUTTON -->

            <Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Padding="16,8"
                Click="ClearFilterButton_Click">

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

                    <SymbolIcon Symbol="Clear"/>

                    <TextBlock
                        Text="Clear"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>


        <!-- TABLE + PAGINATION -->

        <Grid
            Grid.Row="2"
            RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                BorderThickness="1"
                BorderBrush="{StaticResource RowDividerBrush}"
                CornerRadius="8">

                <ListView
                    x:Name="BillingList"
                    SelectionMode="None">

                    <ListView.Header>

                        <Border
                            BorderBrush="{StaticResource RowDividerBrush}"
                            BorderThickness="0,0,0,1">

                            <Grid Padding="16,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Customer"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Device"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Repair"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="Status"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="Action"
                                    FontWeight="SemiBold"
                                    MinWidth="100"/>

                            </Grid>

                        </Border>

                    </ListView.Header>


                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BorderBrush="{StaticResource RowDividerBrush}"
                                BorderThickness="0,0,0,1">

                                <Grid Padding="16,12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding CustomerName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>


                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DeviceName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>


                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding RepairDescription}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis"/>


                                    <TextBlock
                                        Grid.Column="3"
                                        Text="Completed"
                                        VerticalAlignment="Center"/>


                                    <Button
                                        Grid.Column="4"
                                        MinWidth="100"
                                        Click="PayButton_Click">

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                            <SymbolIcon
                                                Symbol="Accept"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Text="Pay"
                                                VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Button>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Border>


            <!-- PAGINATION -->

            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="12">

                <Button
                    x:Name="PreviousPageButton"
                    Click="PreviousPageButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Back"/>
                        <TextBlock Text="Previous" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock
                    x:Name="PageInfoText"
                    VerticalAlignment="Center"/>

                <Button
                    x:Name="NextPageButton"
                    Click="NextPageButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                        <SymbolIcon Symbol="Forward"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Grid>

    </Grid>

</Page>