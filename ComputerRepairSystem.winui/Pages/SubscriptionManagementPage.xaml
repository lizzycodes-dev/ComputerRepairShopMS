<Page
    x:Class="ComputerRepairSystem_winui.Pages.SubscriptionManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24">

        <!-- ===================================================== -->
        <!-- PAGE HEADER -->
        <!-- ===================================================== -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="Subscription Editor"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Configure subscription plans, module access, and company subscriptions."
                FontSize="14"
                Opacity="0.7"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT COLUMN - SUBSCRIPTION PLANS -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                BorderBrush="#666666"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- PLANS HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="2">

                            <TextBlock
                                Text="Subscription Plans"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Select a plan to edit its features."
                                FontSize="12"
                                Opacity="0.65"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Click="AddPlanButton_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <FontIcon
                                    Glyph="&#xE710;"
                                    FontSize="12"/>

                                <TextBlock
                                    Text="Add Plan"/>

                            </StackPanel>

                        </Button>

                    </Grid>


                    <!-- PLAN LIST -->

                    <ListView
                        x:Name="PlansListView"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectionChanged="PlansListView_SelectionChanged"
                        BorderThickness="0">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter
                                    Property="Margin"
                                    Value="0,0,0,8"/>

                                <Setter
                                    Property="Padding"
                                    Value="0"/>

                                <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            </Style>

                        </ListView.ItemContainerStyle>


                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    BorderBrush="#555555"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,12">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <!-- PLAN INFORMATION -->

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="3">

                                            <TextBlock
                                                Text="{Binding PlanName}"
                                                FontSize="16"
                                                FontWeight="SemiBold"/>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6">

                                                <TextBlock
                                                    Text="{Binding EnterpriseType}"
                                                    FontSize="12"
                                                    Opacity="0.7"/>

                                                <TextBlock
                                                    Text="•"
                                                    FontSize="12"
                                                    Opacity="0.5"/>

                                                <TextBlock
                                                    Text="{Binding DurationText}"
                                                    FontSize="12"
                                                    Opacity="0.7"/>

                                            </StackPanel>

                                        </StackPanel>


                                        <!-- PLAN ACTIONS -->

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="{Binding PriceText}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"/>

                                            <Button
                                                Padding="6"
                                                Tag="{Binding}"
                                                Click="EditPlanButton_Click"
                                                ToolTipService.ToolTip="Edit Plan">

                                                <FontIcon
                                                    Glyph="&#xE70F;"
                                                    FontSize="14"/>

                                            </Button>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- RIGHT COLUMN -->
            <!-- ================================================= -->

            <Grid
                Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- INCLUDED MODULES -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="0"
                    BorderBrush="#666666"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- HEADER -->
                            <StackPanel
                                Grid.Column="0"
                                Spacing="2">

                                <TextBlock
                                    Text="Included Feature Modules"
                                    FontSize="20"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Select the modules available for this subscription plan."
                                    FontSize="12"
                                    Opacity="0.65"/>

                            </StackPanel>

                            <!-- ADD MODULE -->
                            <Button
                                Grid.Column="1"
                                Click="AddModuleButton_Click"
                                VerticalAlignment="Center">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <FontIcon
                                        Glyph="&#xE710;"
                                        FontSize="12"/>

                                    <TextBlock
                                        Text="Add Module"/>

                                </StackPanel>

                            </Button>

                        </Grid>


                        <!-- MODULE LIST -->

                        <ListView
                            x:Name="ModulesListView"
                            Grid.Row="2"
                            MaxHeight="220"
                            SelectionMode="None"
                            BorderThickness="0">

                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem">

                                    <Setter
                                        Property="Padding"
                                        Value="0"/>

                                    <Setter
                                        Property="MinHeight"
                                        Value="36"/>

                                    <Setter
                                        Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                </Style>

                            </ListView.ItemContainerStyle>


                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Padding="4,4"
                                        BorderBrush="#555555"
                                        BorderThickness="0,0,0,1">

                                        <CheckBox
                                            Content="{Binding ModuleName}"
                                            IsChecked="{Binding IsIncluded, Mode=TwoWay}"/>

                                    </Border>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>


                        <!-- SAVE -->

                        <Button
                            Grid.Row="4"
                            Content="Save Module Configuration"
                            HorizontalAlignment="Right"
                            Click="SaveModulesButton_Click"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- COMPANY SUBSCRIPTIONS -->
                <!-- ================================================= -->

                <Border
                    Grid.Row="2"
                    BorderBrush="#666666"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Spacing="2">

                                <TextBlock
                                    Text="Active Company Subscriptions"
                                    FontSize="20"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Overview of companies and their current subscription plans."
                                    FontSize="12"
                                    Opacity="0.65"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Click="AddSubscriptionButton_Click">

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">

                                    <FontIcon
                                        Glyph="&#xE710;"
                                        FontSize="12"/>

                                    <TextBlock
                                        Text="Assign Subscription"/>

                                </StackPanel>

                            </Button>

                        </Grid>


                        <!-- TABLE HEADER -->

                        <Border
                            Grid.Row="2"
                            Padding="16,8"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            CornerRadius="4">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Text="Company &amp; Plan"
                                    FontSize="12"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Price"
                                    FontSize="12"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Status"
                                    FontSize="12"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="Start Date"
                                    FontSize="12"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="End Date"
                                    FontSize="12"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="Actions"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Width="120"
                                    TextAlignment="Right"/>

                            </Grid>

                        </Border>


                        <!-- SUBSCRIPTIONS LIST -->

                        <ListView
                            x:Name="CompanySubscriptionsListView"
                            Grid.Row="3"
                            SelectionMode="None"
                            BorderThickness="0">

                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem">

                                    <Setter
                                        Property="Padding"
                                        Value="0"/>

                                    <Setter
                                        Property="Margin"
                                        Value="0,0,0,4"/>

                                    <Setter
                                        Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                </Style>

                            </ListView.ItemContainerStyle>


                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        BorderBrush="#555555"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16,10">

                                        <Grid
                                            VerticalAlignment="Center">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- COMPANY / PLAN -->

                                            <StackPanel
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Spacing="2">

                                                <TextBlock
                                                    Text="{Binding CompanyName}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"/>

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="4">

                                                    <TextBlock
                                                        Text="{Binding PlanName}"
                                                        FontSize="12"
                                                        Opacity="0.7"/>

                                                    <TextBlock
                                                        Text="•"
                                                        FontSize="12"
                                                        Opacity="0.5"/>

                                                    <TextBlock
                                                        Text="{Binding EnterpriseType}"
                                                        FontSize="12"
                                                        Opacity="0.7"/>

                                                </StackPanel>

                                            </StackPanel>


                                            <!-- PRICE -->

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding PriceText}"
                                                FontSize="13"
                                                VerticalAlignment="Center"/>


                                            <!-- STATUS -->

                                            <Border
                                                Grid.Column="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderBrush="#777777"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,2">

                                                <TextBlock
                                                    Text="{Binding Status}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"/>

                                            </Border>


                                            <!-- START DATE -->

                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{Binding StartDateText}"
                                                FontSize="12"
                                                Opacity="0.7"
                                                VerticalAlignment="Center"/>


                                            <!-- END DATE -->

                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding EndDateText}"
                                                FontSize="12"
                                                Opacity="0.7"
                                                VerticalAlignment="Center"/>


                                            <!-- ACTIONS -->

                                            <StackPanel
                                                Grid.Column="5"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                HorizontalAlignment="Right">

                                                <Button
                                                    Content="Change"
                                                    Padding="8,4"
                                                    Tag="{Binding}"
                                                    Click="ChangeSubscriptionButton_Click"/>

                                                <Button
                                                    Content="Renew"
                                                    Padding="8,4"
                                                    Tag="{Binding}"
                                                    Click="RenewSubscriptionButton_Click"/>

                                                <Button
                                                    Content="Cancel"
                                                    Padding="8,4"
                                                    Tag="{Binding}"
                                                    Click="CancelSubscriptionButton_Click"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Page>