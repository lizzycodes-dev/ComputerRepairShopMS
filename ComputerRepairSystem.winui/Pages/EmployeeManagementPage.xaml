<Page
    x:Class="ComputerRepairSystem_winui.Pages.EmployeeManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:ComputerRepairSystem_winui.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <StackPanel
            Grid.Row="0"
            Spacing="6">

            <TextBlock
                Text="Employee Management"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage employee records and employment information."
                Opacity="0.7"/>

        </StackPanel>


        <!-- ========================================== -->
        <!-- TOOLBAR -->
        <!-- ========================================== -->

        <Grid
            Grid.Row="1"
            Margin="0,24,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBox
                x:Name="SearchBox"
                Header="Search"
                PlaceholderText="Search employee..."
                TextChanged="SearchBox_TextChanged"
                Margin="0,0,12,0"/>


            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    x:Name="AddEmployeeButton"
                    Click="AddEmployeeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Add"/>
                        <TextBlock Text="Add Employee" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="EditEmployeeButton"
                    IsEnabled="False"
                    Click="EditEmployeeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Edit"/>
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="DeleteEmployeeButton"
                    IsEnabled="False"
                    Click="DeleteEmployeeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Delete"/>
                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="RefreshEmployeeButton"
                    Click="RefreshEmployeeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Refresh"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Grid>


        <!-- ========================================== -->
        <!-- EMPLOYEE LIST -->
        <!-- ========================================== -->

        <ListView
            x:Name="EmployeesListView"
            Grid.Row="2"
            SelectionMode="Single"
            SelectionChanged="EmployeesListView_SelectionChanged">

            <!-- ====================================== -->
            <!-- TABLE HEADER -->
            <!-- ====================================== -->

            <ListView.Header>

                <Border
                    Padding="12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="1.3*"/>

                            <ColumnDefinition Width="1.3*"/>

                            <ColumnDefinition Width="1.2*"/>

                            <ColumnDefinition
                                x:Name="BranchHeaderColumn"
                                Width="1.2*"/>

                            <ColumnDefinition Width="1.2*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <!-- Employee -->

                        <TextBlock
                            Text="Employee"
                            FontWeight="SemiBold"/>


                        <!-- Position -->

                        <TextBlock
                            Grid.Column="1"
                            Text="Position"
                            FontWeight="SemiBold"/>


                        <!-- Department -->

                        <TextBlock
                            Grid.Column="2"
                            Text="Department"
                            FontWeight="SemiBold"/>


                        <!-- Branch -->

                        <TextBlock
                            x:Name="BranchHeaderText"
                            Grid.Column="3"
                            Text="Branch"
                            FontWeight="SemiBold"/>


                        <!-- Hire Date -->

                        <TextBlock
                            Grid.Column="4"
                            Text="Hire Date"
                            FontWeight="SemiBold"/>


                        <!-- Status -->

                        <TextBlock
                            Grid.Column="5"
                            Text="Status"
                            FontWeight="SemiBold"
                            Margin="20,0,0,0"/>

                    </Grid>

                </Border>

            </ListView.Header>


            <!-- ====================================== -->
            <!-- EMPLOYEE ROW -->
            <!-- ====================================== -->

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                        <Grid Padding="12">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1.3*"/>

                                <ColumnDefinition Width="1.3*"/>

                                <ColumnDefinition Width="1.2*"/>

                                <!-- Branch column dynamically collapses -->
                                <ColumnDefinition
                                    Width="{Binding BranchColumnWidth}"/>

                                <ColumnDefinition Width="1.2*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <!-- Employee -->

                            <TextBlock
                                Text="{Binding FullName}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>


                            <!-- Position -->

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Position}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>


                            <!-- Department -->

                            <TextBlock
                                Grid.Column="2"
                                Text="{Binding DepartmentName}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>


                            <!-- Branch -->

                            <TextBlock
                                Grid.Column="3"
                                Text="{Binding BranchName}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"/>


                            <!-- Hire Date -->

                            <TextBlock
                                Grid.Column="4"
                                Text="{Binding HireDateText}"
                                VerticalAlignment="Center"/>


                            <!-- Status -->

                            <TextBlock
                                Grid.Column="5"
                                Text="{Binding StatusText}"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>


        <!-- ========================================== -->
        <!-- PAGINATION -->
        <!-- ========================================== -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="12"
            Margin="0,16,0,0">

            <Button
                x:Name="PreviousPageButton"
                Click="PreviousPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Back"/>
                    <TextBlock Text="Previous" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="PageInfoText"
                VerticalAlignment="Center"/>

            <Button
                x:Name="NextPageButton"
                Click="NextPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Next" VerticalAlignment="Center"/>
                    <SymbolIcon Symbol="Forward"/>
                </StackPanel>
            </Button>

        </StackPanel>

    </Grid>

</Page>