<Page
    x:Class="ComputerRepairSystem_winui.Pages.DepartmentManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="24"
        RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="Department Management"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Manage company departments and organizational units."
                FontSize="14"
                Opacity="0.7"/>
        </StackPanel>

        <!-- TOOLBAR -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="DepartmentSearchBox"
                Grid.Column="0"
                PlaceholderText="Search departments..."
                TextChanged="DepartmentSearchBox_TextChanged"/>

            <Button
                x:Name="AddDepartmentButton"
                Grid.Column="1"
                Click="AddDepartmentButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="Add Department" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="EditDepartmentButton"
                Grid.Column="2"
                IsEnabled="False"
                Click="EditDepartmentButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Edit"/>
                    <TextBlock Text="Edit" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="DeleteDepartmentButton"
                Grid.Column="3"
                IsEnabled="False"
                Click="DeleteDepartmentButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Delete"/>
                    <TextBlock Text="Delete" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button
                x:Name="RefreshDepartmentButton"
                Grid.Column="4"
                Click="RefreshDepartmentButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Refresh"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- DEPARTMENT LIST -->
        <Border
            Grid.Row="2"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADERS -->
                <Border
                    Grid.Row="0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                    <Grid
                        Padding="16,12"
                        ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Department Name"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Description"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Status"
                            FontWeight="SemiBold"/>

                    </Grid>

                </Border>

                <!-- DEPARTMENTS -->
                <ListView
                    x:Name="DepartmentsListView"
                    Grid.Row="1"
                    SelectionMode="Single"
                    SelectionChanged="DepartmentsListView_SelectionChanged">

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                                <Grid
                                    Padding="16,12"
                                    ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding DepartmentName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Description}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Status}"
                                        VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

        <!-- PAGINATION -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="12">

            <Button
                x:Name="PreviousPageButton"
                Click="PreviousPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Back"/>
                    <TextBlock Text="Previous" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="PageInfoText"
                VerticalAlignment="Center"/>

            <Button
                x:Name="NextPageButton"
                Click="NextPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Next" VerticalAlignment="Center"/>
                    <SymbolIcon Symbol="Forward"/>
                </StackPanel>
            </Button>

        </StackPanel>

    </Grid>

</Page>