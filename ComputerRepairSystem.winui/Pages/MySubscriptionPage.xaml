<Page
    x:Class="ComputerRepairSystem_winui.Pages.MySubscriptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- PAGE HEADER -->
        <!-- ===================================================== -->

        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="My Subscription"
                FontSize="28"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="View your company's current subscription and included features."
                FontSize="14"
                Opacity="0.7"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- CURRENT PLAN -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                BorderBrush="#666666"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- HEADER -->

                    <StackPanel
                        Grid.Row="0"
                        Spacing="3">

                        <TextBlock
                            Text="Current Plan"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Your company's active subscription"
                            FontSize="12"
                            Opacity="0.65"/>

                    </StackPanel>


                    <!-- PLAN NAME -->

                    <StackPanel
                        Grid.Row="2"
                        Spacing="4">

                        <TextBlock
                            Text="Plan"
                            FontSize="12"
                            Opacity="0.65"/>

                        <TextBlock
                            x:Name="PlanNameText"
                            Text="—"
                            FontSize="24"
                            FontWeight="SemiBold"/>

                    </StackPanel>


                    <!-- ENTERPRISE TYPE -->

                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0" Spacing="4">

                            <TextBlock
                                Text="Enterprise Type"
                                FontSize="12"
                                Opacity="0.65"/>

                            <TextBlock
                                x:Name="EnterpriseTypeText"
                                Text="—"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1" Spacing="4">

                            <TextBlock
                                Text="Price"
                                FontSize="12"
                                Opacity="0.65"/>

                            <TextBlock
                                x:Name="PriceText"
                                Text="—"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                    </Grid>


                    <!-- STATUS -->

                    <StackPanel
                        Grid.Row="6"
                        Spacing="4">

                        <TextBlock
                            Text="Status"
                            FontSize="12"
                            Opacity="0.65"/>

                        <Border
                            HorizontalAlignment="Left"
                            BorderBrush="#777777"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,4">

                            <TextBlock
                                x:Name="StatusText"
                                Text="—"
                                FontSize="13"
                                FontWeight="SemiBold"/>

                        </Border>

                    </StackPanel>


                    <!-- EMPTY SPACE -->

                    <Grid Grid.Row="7"/>


                    <!-- RENEW BUTTON -->

                    <Button
                        x:Name="RenewButton"
                        Grid.Row="8"
                        Content="Renew Subscription"
                        HorizontalAlignment="Stretch"
                        Click="RenewButton_Click"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- SUBSCRIPTION DETAILS -->
            <!-- ================================================= -->

            <Border
                Grid.Column="2"
                BorderBrush="#666666"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- HEADER -->

                    <StackPanel
                        Grid.Row="0"
                        Spacing="3">

                        <TextBlock
                            Text="Subscription Details"
                            FontSize="20"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Billing period and available feature modules"
                            FontSize="12"
                            Opacity="0.65"/>

                    </StackPanel>


                    <!-- DATES -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">

                            <TextBlock
                                Text="Start Date"
                                FontSize="12"
                                Opacity="0.65"/>

                            <TextBlock
                                x:Name="StartDateText"
                                Text="—"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1"
                            Spacing="4">

                            <TextBlock
                                Text="End Date"
                                FontSize="12"
                                Opacity="0.65"/>

                            <TextBlock
                                x:Name="EndDateText"
                                Text="—"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                    </Grid>


                    <!-- MODULES -->

                    <StackPanel
                        Grid.Row="4"
                        Spacing="10">

                        <TextBlock
                            Text="Included Feature Modules"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                        <ListView
                            x:Name="ModulesListView"
                            SelectionMode="None"
                            BorderThickness="1"
                            BorderBrush="#555555">

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Padding="10,8"
                                        BorderBrush="#555555"
                                        BorderThickness="0,0,0,1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{Binding ModuleName}"
                                                FontSize="14"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="Included"
                                                FontSize="12"
                                                Opacity="0.65"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>