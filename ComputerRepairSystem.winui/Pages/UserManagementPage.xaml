<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="ComputerRepairSystem_winui.Pages.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="24,16,24,16"
        RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- PAGE HEADER -->

        <StackPanel Spacing="4">

            <TextBlock
                Text="User Management"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                Text="Manage system users and their access."
                Opacity="0.7" />

        </StackPanel>


        <!-- ACTION BAR -->

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- SEARCH -->

            <TextBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search user..."
                TextChanged="SearchBox_TextChanged"/>


            <!-- BUTTONS -->

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="12">

                <Button Click="AddUserButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Add"/>
                        <TextBlock Text="Add User" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="EditUserButton"
                    Click="EditUserButton_Click"
                    IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Edit"/>
                        <TextBlock Text="Edit User" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button
                    x:Name="DeleteUserButton"
                    Click="DeleteUserButton_Click"
                    IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Delete"/>
                        <TextBlock Text="Delete User" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Refresh"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>

        </Grid>


        <!-- USER LIST -->

        <Border
            Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            CornerRadius="8">

            <ListView
                x:Name="UsersListView"
                SelectionMode="Single"
                SelectionChanged="UsersListView_SelectionChanged">

                <ListView.Header>

                    <Border
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                        <Grid Padding="16,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Username"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="1"
                                Text="Email"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="2"
                                Text="Role"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="3"
                                Text="Company Name"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Grid.Column="4"
                                Text="Status"
                                FontWeight="SemiBold" />

                        </Grid>

                    </Border>

                </ListView.Header>


                <ListView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">

                            <Grid Padding="16,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding User.UserName}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding User.Email}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Role}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding CompanyName}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding StatusText}"
                                    VerticalAlignment="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Border>


        <!-- PAGINATION -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Spacing="12">

            <Button
                x:Name="PreviousPageButton"
                Click="PreviousPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Back"/>
                    <TextBlock Text="Previous" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="PageInfoText"
                VerticalAlignment="Center" />

            <Button
                x:Name="NextPageButton"
                Click="NextPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Next" VerticalAlignment="Center"/>
                    <SymbolIcon Symbol="Forward"/>
                </StackPanel>
            </Button>

        </StackPanel>

    </Grid>

</Page>