<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ComputerRepairSystem_winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComputerRepairSystem_winui"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ComputerRepairSystem.winui"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CUSTOM TITLE BAR -->
        <Grid
    x:Name="AppTitleBar"
    Height="48"
    Background="#1D1C28"
    Padding="12,0,150,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- MENU BUTTON -->

            <Button
        Grid.Column="0"
        x:Name="PaneToggleButton"
        Width="40"
        Height="40"
        Padding="0"
        VerticalAlignment="Center"
        Click="TitleBar_PaneToggleRequested">

                <SymbolIcon
            Symbol="GlobalNavigationButton"/>

            </Button>


            <!-- LOGO -->

            <Image
        Grid.Column="1"
        Source="ms-appx:///Assets/LogoIT13CRS.png"
        Width="30"
        Height="30"
        Margin="8,0,8,0"
        VerticalAlignment="Center"
        Stretch="Uniform"/>


            <!-- FIXFLOW -->

            <TextBlock
        Grid.Column="2"
        Text="FIXFLOW"
        VerticalAlignment="Center"
        FontSize="18"
        FontWeight="SemiBold"/>


            <!-- RIGHT SIDE -->

            <StackPanel
        Grid.Column="3"
        Orientation="Horizontal"
        VerticalAlignment="Center"
        Spacing="6">


                <!-- SEARCH -->

                <Button
            x:Name="GlobalSearchButton"
            Width="40"
            Height="40"
            Padding="0"
            ToolTipService.ToolTip="Search"
            Click="GlobalSearchButton_Click">

                    <SymbolIcon
                Symbol="Find"/>

                </Button>


                <!-- NOTIFICATIONS -->

                <Button
            x:Name="NotificationButton"
            Width="40"
            Height="40"
            Padding="0"
            ToolTipService.ToolTip="Notifications"
            Click="NotificationButton_Click">

                    <SymbolIcon
                Symbol="OtherUser"/>

                </Button>


                <!-- PROFILE -->

                <Button
            x:Name="ProfileButton"
            Height="40"
            Padding="8,0"
            ToolTipService.ToolTip="Profile"
            Click="ProfileButton_Click">

                    <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">

                        <PersonPicture
                    Width="30"
                    Height="30"/>

                        <TextBlock
                    x:Name="UserNameText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>

        <Grid Grid.Row="1">

            <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            IsSettingsVisible="False"
            IsPaneOpen="False">

                <NavigationView.MenuItems>

                    <!-- HOME -->
                    <NavigationViewItem
                    x:Name="HomeItem"
                    Content="Home"
                    IsSelected="True"
                    Tag="home">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Home"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>


                    <!-- SERVICE MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="ServiceManagementItem"
                    Content="Service Management"
                    Tag="customers">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Contact"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>


                    <!-- REPAIR MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="RepairManagementItem"
                    Content="Repair Management"
                    Tag="repairs">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Repair"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>


                    <!-- BILLING -->
                    <NavigationViewItem
                    x:Name="BillingItem"
                    Content="Billing"
                    Tag="billing">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Calculator"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>


                    <!-- COMPANY MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="CompanyManagementItem"
                    Content="Company Management"
                    Tag="companies">

                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xEC06;"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <!-- USER MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="UserManagementItem"
                    Content="User Management"
                    Tag="users">

                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="People"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>


                    <!-- CUSTOMER MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="CustomerManagementItem"
                    Content="Customers"
                    Tag="customer-management">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Contact2"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <!-- EMPLOYEE MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="EmployeeManagementItem"
                    Content="Employees"
                    Tag="employee-management">

                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Contact"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <!-- BRANCH MANAGEMENT -->
                    <NavigationViewItem
                        x:Name="BranchManagementItem"
                        Content="Branch Management"
                        Tag="branch-management">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                Glyph="&#xE707;"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>
                    
                    <!-- DEPARTMENT MANAGEMENT -->
                    <NavigationViewItem
                        x:Name="DepartmentManagementItem"
                        Content="Department Management"
                        Tag="department-management">

                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                Glyph="&#xE902;"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>
                    
                    <!-- ATTENDANCE MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="AttendanceManagementItem"
                    Content="Attendance Management"
                    Tag="attendance-management">

                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Calendar"/>
                        </NavigationViewItem.Icon>

                        <!-- PAYROLL MANAGEMENT -->
                    </NavigationViewItem>

                    <NavigationViewItem
                    x:Name="PayrollManagementItem"
                    Content="Payroll Management"
                    Tag="payroll-management">

                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Calculator"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <!--- FINANCE MANAGEMENT -->
                    <NavigationViewItem 
                     x:Name="FinanceManagementItem"
                     Content="Finance Management"
                     Tag="finance-management">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xEC59;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <!-- INVENTORY -->
                    <NavigationViewItem
                    x:Name="InventoryItem"
                    Content="Inventory"
                    Tag="inventory">

                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <!-- SUPPLIER MANAGEMENT -->
                    <NavigationViewItem
                    x:Name="SupplierManagementItem"
                    Content="Supplier Management"
                    Tag="supplier-management">

                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Shop"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <!-- PURCHASE MANAGEMENT -->
                    <NavigationViewItem
                        x:Name="PurchaseManagementItem"
                        Content="Purchase Management"
                        Tag="purchase-management">

                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                Glyph="&#xE7BF;" />
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    <!-- MY SUBSCRIPTION -->
                    <NavigationViewItem
                        x:Name="MySubscriptionItem"
                        Content="My Subscription"
                        Tag="my-subscription">

                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D7;"/>
                        </NavigationViewItem.Icon>

                    </NavigationViewItem>

                    
                    <!-- SYSTEM SETTINGS -->
                    <NavigationViewItem
                    x:Name="SystemSettingsItem"
                    Content="System Settings"
                    Tag="settings">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <!-- TERMS AND CONDITIONS -->
                    <NavigationViewItem
                    x:Name="TermsAndConditionItem"
                    Content="Terms and Conditions"
                    Tag="terms-and-conditions">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="ProtectedDocument"/>
                            </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    
                    <NavigationViewItem 
                    x:Name="SubscriptionManagementItem"
                    Content="Subscription Management"
                    Tag="subscription-management">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Tag"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                </NavigationView.MenuItems>
                <Frame
                x:Name="NavFrame" />

            </NavigationView>

        </Grid>

    </Grid>
</Window>
